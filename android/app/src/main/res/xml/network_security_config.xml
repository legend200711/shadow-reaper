<?xml version="1.0" encoding="utf-8"?>
<!-- Shadow Reaper — Network Security Configuration
     Allows HTTPS to all domains. No cleartext HTTP traffic is permitted.
     The Capacitor WebView loads content from the assets bundle (not a remote host),
     so no domain exceptions are needed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

# Shadow Reaper Standalone — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# The .env file is in .gitignore and must NEVER be committed to GitHub.
#
# ⚠️  DO NOT paste Shadow Nexus Social credentials here.
# ⚠️  DO NOT paste from horr-a08f4.
# ⚠️  This project uses its own dedicated Firebase project.

# ── Firebase — Shadow Reaper Standalone project only ────────────────────────
# Get these values from: Firebase Console → Project Settings → Your apps → Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Cloudflare — Shadow Reaper Standalone resources only ────────────────────
# Get these from: Cloudflare Dashboard → Account ID, and API Tokens page
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker endpoints (fill in after Workers are deployed)
SR_WORKER_BASE_URL=
SR_RESEARCH_ENDPOINT=/research
SR_KNOWLEDGE_ENDPOINT=/knowledge

# ── Internal security ────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
SR_INTERNAL_API_KEY=

# ── Environment ──────────────────────────────────────────────────────────────
SR_ENV=development

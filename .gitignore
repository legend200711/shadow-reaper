# Shadow Reaper Standalone — .gitignore
#
# SECURITY: Never commit credentials, secrets, or environment files.

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
*.env

# ── Firebase service account keys (NEVER COMMIT) ────────────────────────────
*serviceAccount*.json
*firebase-adminsdk*.json
firebase-debug.log
firebase-debug.*.log
.firebase/

# ── Cloudflare secrets ───────────────────────────────────────────────────────
.wrangler/
wrangler.log

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
.cache/

# ── Android build artifacts ───────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/.idea/
android/local.properties
*.apk
# Exception: distribution APK served by the website is intentionally committed
!downloads/ShadowReaper.apk
*.aab
*.keystore

# ── Capacitor web bundle (auto-generated by build-www.js + npx cap sync) ──────
# www/ is auto-generated — regenerate with: npm run build:android
www/

# ── Capacitor ─────────────────────────────────────────────────────────────────
.capacitor-info.json

# ── Release signing (NEVER commit these) ──────────────────────────────────────
release-keys/
*.keystore
*.jks
keystore.properties
